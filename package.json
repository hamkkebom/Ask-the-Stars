{
  "name": "ask-the-stars",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "20.x",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.2",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "prepare": "husky",
    "sync:stack": "node scripts/sync-tech-stack.js",
    "postinstall": "prisma generate --schema=packages/database/prisma/schema.prisma"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.713.0",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "prisma": "6.3.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "tar@<=7.5.2": ">=7.5.3",
      "tar@<=7.5.3": ">=7.5.4",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "next@>=15.0.0-canary.0 <15.6.0-canary.61": ">=15.6.0-canary.61",
      "tar@<7.5.7": ">=7.5.7",
      "diff@>=4.0.0 <4.0.4": ">=4.0.4",
      "fast-xml-parser@>=4.3.6 <=5.3.3": ">=5.3.4"
    }
  }
}
