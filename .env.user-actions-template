# =============================================
# User Action Required - Environment Variables
# =============================================
# 
# Copy these variables to your .env file after completing the setup steps.
# See setup guides in scripts/ directory for detailed instructions.

# --- E2E Test Accounts (High Priority) ---
# See: scripts/setup-e2e-accounts.md
# 
# IMPORTANT: Use PLAIN TEXT passwords here (not hashes)
# These passwords must match what you used to generate bcrypt hashes in the database
#
E2E_STAR_EMAIL="test-star@hamkkebom.com"
E2E_STAR_PASSWORD="TestPassword123!"
E2E_ADMIN_EMAIL="test-admin@hamkkebom.com"
E2E_ADMIN_PASSWORD="AdminPassword456!"

# --- Cloudflare Image Variants (High Priority) ---
# See: scripts/setup-cloudflare-variants.md
#
# IMPORTANT: These names must EXACTLY match the variant names in Cloudflare Dashboard
# Case-sensitive!
#
CLOUDFLARE_IMAGES_VARIANT_SM="thumbnail-sm"
CLOUDFLARE_IMAGES_VARIANT_MD="thumbnail-md"
CLOUDFLARE_IMAGES_VARIANT_LG="thumbnail-lg"

# --- Cloudflare Account Info (Required for Image Variants) ---
# Find these in: Cloudflare Dashboard → Images → Overview
#
# CLOUDFLARE_ACCOUNT_ID="your-account-id-here"
# CLOUDFLARE_IMAGES_ACCOUNT_HASH="your-account-hash-here"

# =============================================
# Quick Setup Checklist
# =============================================
#
# [ ] 1. Generate password hashes:
#        node scripts/generate-bcrypt-hash.js TestPassword123!
#        node scripts/generate-bcrypt-hash.js AdminPassword456!
#
# [ ] 2. Create test accounts in Supabase:
#        Follow scripts/setup-e2e-accounts.md
#
# [ ] 3. Create Cloudflare Image Variants:
#        Follow scripts/setup-cloudflare-variants.md
#
# [ ] 4. Copy this file's content to .env
#
# [ ] 5. Verify setup:
#        pnpm e2e
#        node scripts/test-thumbnail-variants.js
#
